# Автоматическое определение текстовых файлов и нормализация окончаний строк
* text=auto

# ==========================================
# Файлы КОМПАС-3D (бинарные форматы)
# Запрет изменения окончаний строк (CRLF/LF) во избежание повреждения файлов
# ==========================================
*.m3d binary
*.a3d binary
*.cdw binary
*.spw binary
*.frw binary
*.kdw binary
*.tpl binary

# ==========================================
# Нейтральные форматы 3D CAD и полигональные сетки
# ==========================================
*.step binary
*.stp binary
*.iges binary
*.igs binary
*.stl binary
*.3mf binary
*.obj binary
*.sat binary
*.x_t binary
*.x_b binary

# ==========================================
# Чертежные и графические форматы
# ==========================================
*.dwg binary
*.dxf binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

# ==========================================
# Пример настройки Git LFS (если файлы станут очень большими):
# Чтобы включить Git LFS, выполните в терминале `git lfs install`
# и замените `binary` на:
# *.m3d filter=lfs diff=lfs merge=lfs -text
# *.a3d filter=lfs diff=lfs merge=lfs -text
# ==========================================
